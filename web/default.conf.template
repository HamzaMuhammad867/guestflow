server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # The browser calls /api on the same origin; nginx forwards to the API (no CORS needed).
  # API_UPSTREAM = http://api:8080 locally (docker compose) or http://<api-app-name> in Azure Container Apps.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    try_files $uri /index.html;
  }
}
